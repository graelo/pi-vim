{
  "name": "@graelo/pi-vim",
  "version": "1.0.0",
  "description": "Vim mode for the pi coding agent prompt editor",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": {
      "types": "./src/vim-config.d.ts"
    }
  },
  "files": [
    "src",
    "docs/config.md",
    "docs/features.md",
    "docs/settings.md",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check . && npm run lint:md",
    "lint:md": "rumdl check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx benchmark/run.ts",
    "generate:config-reference": "tsx scripts/generate-config-reference.ts",
    "check:config-reference": "tsx scripts/generate-config-reference.ts --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24",
    "rumdl": "^0.2.10",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graelo/pi-vim.git"
  },
  "homepage": "https://github.com/graelo/pi-vim#readme",
  "bugs": {
    "url": "https://github.com/graelo/pi-vim/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "vim",
    "modal-editing"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "contributors": [
    "pekochan069",
    "graelo <graelo@graelo.cc>"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@graelo/pi-ext-config": "^0.2.0"
  }
}
